diff --git a/lm_eval/api/metrics.py b/lm_eval/api/metrics.py
index 0f142f75..3259c0c6 100644
--- a/lm_eval/api/metrics.py
+++ b/lm_eval/api/metrics.py
@@ -251,8 +251,35 @@ def exact_match_hf_evaluate(
     output_type="generate_until",
     aggregation="mean",
 )
-def exact_match_fn(**kwargs):
-    return exact_match_hf_evaluate(**kwargs)
+def exact_match_fn(predictions, references, **kwargs):
+    """Exact match, where a filter may forward several candidate extractions.
+
+    `predictions` is one entry per document. Normally each entry is the single
+    string its filter chain extracted, and this is plain exact match. A chain may
+    instead forward a *list* of candidates for one document -- `regex_all` does --
+    and then the document counts as correct when any candidate matches its
+    reference. That is the only way the two cases differ: candidates are
+    normalized and compared by `exact_match_hf_evaluate` either way, so a
+    one-candidate list scores exactly as the bare string would.
+
+    Scoring "any candidate" here rather than in the filter is what keeps the gold
+    answer out of the filters, which never see it.
+    """
+    scores = []
+    for prediction, reference in zip(predictions, references):
+        candidates = (
+            list(prediction) if isinstance(prediction, (list, tuple)) else [prediction]
+        )
+        if not candidates:
+            scores.append(0.0)
+            continue
+        hit = exact_match_hf_evaluate(
+            predictions=candidates,
+            references=[reference] * len(candidates),
+            **kwargs,
+        )["exact_match"]
+        scores.append(1.0 if hit > 0.0 else 0.0)
+    return {"exact_match": float(np.mean(scores)) if scores else 0.0}
 
 
