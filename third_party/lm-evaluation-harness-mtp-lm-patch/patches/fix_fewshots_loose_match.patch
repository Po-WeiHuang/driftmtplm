diff --git a/lm_eval/filters/extraction.py b/lm_eval/filters/extraction.py
index a05f3661..c2b72234 100644
--- a/lm_eval/filters/extraction.py
+++ b/lm_eval/filters/extraction.py
@@ -235,3 +235,126 @@ class MultiChoiceRegexFilter(RegexFilter):
             filtered_resps.append(filtered)
 
         return filtered_resps
+
+
+@register_filter("regex_all")
+class RegexAllFilter(Filter):
+    """`regex`, but forwarding every match instead of picking one.
+
+    `RegexFilter` reduces each response to a single extraction chosen by
+    `group_select` -- `-1` for the last one, which is what flexible-extract does.
+    This keeps them all, in order of appearance, and hands the list on as the
+    filtered response. `exact_match` scores the document correct when any
+    candidate in that list matches the gold answer, so the filter itself never
+    needs the gold: the only thing separating it from flexible-extract is how
+    many candidates it forwards.
+
+    Group handling mirrors `RegexFilter`: with capture groups, each match
+    contributes its first non-empty group, so a pattern behaves the same here as
+    it does there.
+    """
+
+    def __init__(
+        self,
+        regex_pattern: str = r"#### (\-?[0-9\.\,]+)",
+        fallback: str = "[invalid]",
+    ) -> None:
+        self.regex_pattern = regex_pattern
+        self.regex = re.compile(regex_pattern)
+        self.fallback = fallback
+
+    def apply(self, resps: list[list[str]], docs: list[dict]) -> list[list[list[str]]]:
+        def filter_set(inst):
+            filtered = []
+            for resp in inst:
+                if not isinstance(resp, str):
+                    resp = ""
+                candidates = []
+                for match in self.regex.findall(resp):
+                    if isinstance(match, tuple):
+                        groups = [m for m in match if m]
+                        if not groups:
+                            continue
+                        match = groups[0]
+                    candidates.append(match.strip())
+                filtered.append(candidates or [self.fallback])
+            return filtered
+
+        return [filter_set(inst) for inst in resps]
+
+
+@register_filter("answer_span")
+class AnswerSpanFilter(Filter):
+    """The model's final answer, rather than merely its last number.
+
+    `regex` with `group_select: -1` -- flexible-extract -- keeps the last
+    number-like span, which loses whenever the generation signs off by restating
+    the question: "James responds to 320 emails in a 5-day work week" keeps 5.
+    This keeps the last span of the *concluding sentence* that was not already a
+    number in the question, i.e. 320, and falls back in order to the last span of
+    that sentence, then to the last span overall.
+
+    The concluding sentence is only trusted when the generation actually finished
+    one. A generation cut off mid-sentence has no conclusion to read, so it
+    degrades to plain last-span behaviour; without that guard the rule loses about
+    as much as it gains once generations start degrading.
+
+    Both halves are needed: restricting to the final sentence alone changes almost
+    nothing (the last span is usually there anyway), but it is what stops the
+    not-in-the-question test from reaching back into the working and picking up a
+    stray intermediate.
+
+    Measured over nine checkpoint x k cells of gsm8k_cot_singleshot, this never
+    raised the rate at which the extracted span coincidentally equals some *other*
+    document's answer, and recovered 1-40 documents per cell against 1-5 lost.
+    """
+
+    _SENTENCE_END = re.compile(r"[.!?%]\s*$")
+    _SENTENCE_SPLIT = re.compile(r"(?<=[.!?])\s+|\n+")
+
+    def __init__(
+        self,
+        regex_pattern: str = r"(-?[$0-9.,]{2,})|(-?[0-9]+)",
+        fallback: str = "[invalid]",
+        question_key: str = "question",
+    ) -> None:
+        self.regex_pattern = regex_pattern
+        self.regex = re.compile(regex_pattern)
+        self.fallback = fallback
+        self.question_key = question_key
+
+    @staticmethod
+    def _key(span: str) -> str:
+        """Compare spans the way the metric will: $40,000. and 40000 are one number."""
+        s = span.replace(",", "").replace("$", "")
+        s = re.sub(r"\.$", "", s)
+        return re.sub(r"\.0*$", "", s).lower()
+
+    def _spans(self, resp: str) -> list[tuple[str, int]]:
+        return [(m.group(0).strip(), m.start()) for m in self.regex.finditer(resp)]
+
+    def apply(self, resps: list[list[str]], docs: list[dict]) -> list[list[str]]:
+        filtered_resps = []
+        for inst_resps, doc in zip(resps, docs):
+            asked = {
+                self._key(t)
+                for t, _ in self._spans(str(doc.get(self.question_key, "")))
+            }
+            filtered = []
+            for resp in inst_resps:
+                if not isinstance(resp, str):
+                    resp = ""
+                spans = self._spans(resp)
+                if not spans:
+                    filtered.append(self.fallback)
+                    continue
+                if not self._SENTENCE_END.search(resp):
+                    filtered.append(spans[-1][0])       # no conclusion to trust
+                    continue
+                breaks = list(self._SENTENCE_SPLIT.finditer(resp.strip()))
+                cut = breaks[-1].end() if breaks else 0
+                final = [x for x in spans if x[1] >= cut]
+                novel = [x for x in final if self._key(x[0]) not in asked]
+                filtered.append((novel or final or spans)[-1][0])
+            filtered_resps.append(filtered)
+        return filtered_resps
