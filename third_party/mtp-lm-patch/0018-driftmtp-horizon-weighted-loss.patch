+def _validate_horizon_weight_flags(ss: SingleShotArgs) -> list:
+    """Reject invalid horizon-weighted-loss settings; return non-fatal warnings. Standalone
+    like `_validate_regulariser_flags`, so it can be tested without Fabric
+    (tests/test_driftmtp_horizon_weighting.py). See fixedkweightedplan_zh-TW.md and
+    src/driftmtp/horizon_weighting.py."""
+    if not ss.horizon_weight_enabled:
+        # gamma is not read with the switch off; a non-default value is most likely a
+        # forgotten switch.
+        if ss.horizon_loss_gamma != SingleShotArgs.horizon_loss_gamma:
+            return [f"horizon_loss_gamma={ss.horizon_loss_gamma} is ignored because horizon_weight_enabled=False."]
+        return []
+    if not 0.0 < ss.horizon_loss_gamma <= 1.0:
+        raise ValueError(f"horizon_loss_gamma must be in (0, 1], got {ss.horizon_loss_gamma}.")
+    if ss.hard_self_teacher_supervision:
+        raise ValueError("horizon_weight_enabled is not supported with hard_self_teacher_supervision: "
+                         "the matched positions it keeps are not the same number on every horizon.")
+    return []
