universe   = vanilla
executable = /home/huangp/aiproj/driftmtplm/condor/pretrain_reproduce_full.sh

# --- GPU / resource requests ---
request_gpus   = 1
request_cpus   = 8
request_memory = 64G
request_disk   = 20G

# reproduce_full.yaml uses fsdp_device_mesh: 1x1 -> single-GPU job.
# Bump request_gpus (and the config's fsdp_device_mesh) together if you
# switch to a multi-GPU config.

# --- environment ---
getenv     = false
should_transfer_files = NO
# paths in the job script live under /data/snoplus, which is on shared
# storage mounted on the execute nodes, so no file transfer is needed.

# --- logging ---
log    = /home/huangp/aiproj/driftmtplm/condor/logs/pretrain_reproduce_full.$(Cluster).log
output = /home/huangp/aiproj/driftmtplm/condor/logs/pretrain_reproduce_full.$(Cluster).out
error  = /home/huangp/aiproj/driftmtplm/condor/logs/pretrain_reproduce_full.$(Cluster).err

queue 1
